# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/
*.swp

# Generated model files
models/*
!models/.gitkeep
*.h5
*.keras
*.ckpt

# Generated MIDI and output files
outputs/*
!outputs/.gitkeep
*.wav
*.wave
*.tmp
*.temp
*.log

# Streamlit runtime cache (configuration files remain trackable)
.streamlit/cache/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Local raw datasets (preserve only folder placeholders)
data/raw/*
!data/raw/.gitkeep
!data/raw/classical/
data/raw/classical/*
!data/raw/classical/.gitkeep
!data/raw/jazz/
data/raw/jazz/*
!data/raw/jazz/.gitkeep
